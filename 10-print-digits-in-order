int  ReadPositivNumber(string massge) {


    int  number = 0;

    do {
        cout << massge << endl;
        cin >> number;


    } while (number <= 0);


    return number;

}



int ReverseNumber(int Number)
{

    int Remainder = 0, Numbber2 = 0;

    while (Number > 0) {
        Remainder = Number % 10;
        Number = Number / 10;
        Numbber2 = Numbber2 * 10 + Remainder;


    }

    return Numbber2;

}




