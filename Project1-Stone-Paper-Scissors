#include <iostream>
#include <cstdlib>
#include <ctime>
#include <limits>
using namespace std;

enum enStonePaperScissors
{
    Stone = 1,
    Paper = 2,
    Scissors = 3
};

enum enWinner
{
    Win = 1,
    Draw = 2,
    Loser = 3
};

struct stGame
{
    enStonePaperScissors PlayerChoice;
    enStonePaperScissors ComputerChoice;
    enWinner WinnerPlayer;
};

// Read a number within a specific range
int ReadNumber(int From, int To, string Message)
{
    int Number;

    do
    {
        cout << Message;

        if (!(cin >> Number))
        {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
            Number = From - 1;
        }

    } while (Number < From || Number > To);

    return Number;
}

// Generate a random number
int RandomNumber(int From, int To)
{
    return rand() % (To - From + 1) + From;
}

// Display player choices
void MapOnePlay()
{
    cout << "Stone [1], Paper [2], Scissors [3]\n";
}

// Read player's choice
enStonePaperScissors PlayerChose()
{
    MapOnePlay();

    return (enStonePaperScissors)
        ReadNumber(1, 3, "Enter your choice: ");
}

// Generate computer's choice
enStonePaperScissors ComputerChose()
{
    return (enStonePaperScissors)RandomNumber(1, 3);
}

// Return the winner of the round
enWinner TheWinner(enStonePaperScissors Player,
                   enStonePaperScissors Computer)
{
    if (Player == Computer)
        return Draw;

    if ((Player == Paper && Computer == Stone) ||
        (Player == Stone && Computer == Scissors) ||
        (Player == Scissors && Computer == Paper))
    {
        return Win;
    }

    return Loser;
}

// Return choice name
string ChoiceName(enStonePaperScissors Choice)
{
    switch (Choice)
    {
    case Stone:
        return "Stone";

    case Paper:
        return "Paper";

    case Scissors:
        return "Scissors";

    default:
        return "Unknown";
    }
}

// Display the round result
void PrintRoundResults(stGame Game)
{
    cout << "\nPlayer choice   : "
         << ChoiceName(Game.PlayerChoice) << endl;

    cout << "Computer choice : "
         << ChoiceName(Game.ComputerChoice) << endl;

    if (Game.WinnerPlayer == Win)
    {
        cout << "Round winner    : Player\n";
        system("color 2F");
    }
    else if (Game.WinnerPlayer == Loser)
    {
        cout << "Round winner    : Computer\n";
        system("color 4F");
        cout << "\a";
    }
    else
    {
        cout << "Round winner    : Draw\n";
        system("color 6F");
    }
}

// Play one round
stGame TheWinners()
{
    stGame Game;

    Game.PlayerChoice = PlayerChose();
    Game.ComputerChoice = ComputerChose();

    Game.WinnerPlayer =
        TheWinner(Game.PlayerChoice, Game.ComputerChoice);

    return Game;
}

// Display game results
void ShowGameResults(int Rounds, int PlayerWins,
                     int ComputerWins, int Draws)
{
    cout << "\n--------------------------------------------------\n";
    cout << "\t\tGAME OVER\n";
    cout << "--------------------------------------------------\n";

    cout << "\n-------------- Game Results --------------\n";

    cout << "Game rounds       : " << Rounds << endl;
    cout << "Player wins       : " << PlayerWins << endl;
    cout << "Computer wins     : " << ComputerWins << endl;
    cout << "Draws             : " << Draws << endl;

    if (PlayerWins > ComputerWins)
    {
        cout << "Final winner      : Player\n";
        system("color 2F");
    }
    else if (ComputerWins > PlayerWins)
    {
        cout << "Final winner      : Computer\n";
        system("color 4F");
    }
    else
    {
        cout << "Final result      : Draw\n";
        system("color 6F");
    }

    cout << "------------------------------------------\n";
}

// Play all rounds
void AllRounds()
{
    cout << "********************************************************\n";
    cout << "\t\tSTONE PAPER SCISSORS\n";
    cout << "********************************************************\n";

    int Rounds = ReadNumber(
        1, 10, "How many rounds? [1-10]: ");

    int PlayerWins = 0;
    int ComputerWins = 0;
    int Draws = 0;

    for (int i = 1; i <= Rounds; i++)
    {
        cout << "\n----------- Round [" << i << "] -----------\n";

        stGame Game = TheWinners();

        if (Game.WinnerPlayer == Win)
        {
            PlayerWins++;
        }
        else if (Game.WinnerPlayer == Loser)
        {
            ComputerWins++;
        }
        else
        {
            Draws++;
        }

        PrintRoundResults(Game);
    }

    ShowGameResults(
        Rounds, PlayerWins, ComputerWins, Draws);
}

// Clear the screen
void Cleans()
{
    system("cls");
    system("color 0F");
}

// Ask the player to play again
void Again()
{
    char Answer;

    do
    {
        AllRounds();

        cout << "\nDo you want to play another game? [Y/N]: ";
        cin >> Answer;

        while (Answer != 'Y' && Answer != 'y' &&
               Answer != 'N' && Answer != 'n')
        {
            cout << "Please enter Y or N: ";
            cin >> Answer;
        }

        if (Answer == 'Y' || Answer == 'y')
        {
            Cleans();
        }

    } while (Answer == 'Y' || Answer == 'y');
}

int main()
{
    srand((unsigned)time(NULL));

    Again();

    return 0;
}
