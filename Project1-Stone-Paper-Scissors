#include <iostream>
using namespace std;


enum enStonePapreScissor { Stone = 1, Papre = 2, Scissor = 3 };


enum enWiner { Win = 1, Drow = 2 ,loser=3};

struct stGame {

    enStonePapreScissor PlayerChoes;
    enWiner WinerPlayer;
};

int ReadNumber() {


    int number;


    do {

        cin >> number;

    } while (number < 0);

    return number;

}

int RandomNumber(int From, int To)
{
    int RandomNumber = rand() % (To - From + 1) + From;
    return RandomNumber;

}

void MapOnePlay() {

    cout << "Stone[1] , Paper[2] , Scissor[3]\n";

}

stGame PlayerChose() {

    stGame Player;
    MapOnePlay();
    Player.PlayerChoes = (enStonePapreScissor)ReadNumber();

    return Player;
}

stGame CoputerCose() {

    stGame Computer;
    Computer.PlayerChoes = (enStonePapreScissor)RandomNumber(1, 3);
    return Computer;
}

stGame TheWiners() {

    stGame Player = PlayerChose();
    stGame Computer = CoputerCose();

    if ((Player.PlayerChoes==Papre && Computer.PlayerChoes==Stone)||
        (Player.PlayerChoes==Stone&&Computer.PlayerChoes==Scissor)||
        (Player.PlayerChoes==Scissor&&Computer.PlayerChoes==Papre)) {
    
        Player.WinerPlayer = Win;
    
        return Player;
    
    }
    else if ((Player.PlayerChoes == Papre && Computer.PlayerChoes == Scissor) ||
        (Player.PlayerChoes == Stone && Computer.PlayerChoes == Papre) ||
        (Player.PlayerChoes == Scissor && Computer.PlayerChoes == Stone)) {
    
    
        Player.WinerPlayer = loser;
        return Player;
    
    }
    else {
    
        Player.WinerPlayer = Drow;
        return Player;
    }
    



}

