int  ReadPositivNumber(string massge) {


    int  number = 0;

    do {
        cout << massge << endl;
        cin >> number;


    } while (number <= 0);


    return number;

}

void PrintRevesedOrder(int number) {



    while (number != 0) {

        cout << number % 10 << endl;
        number = number / 10;

    }



}


int  SumOfDigits(int number) {

    int sum=0;

    while (number != 0) {

        sum += number % 10;
        number = number / 10;

    }

    return sum;

}



int PrintReverseNumber(int Number)
{

    int Remainder = 0, Numbber2 = 0;

    while (Number > 0) {
        Remainder = Number % 10;
        Number = Number / 10;
        Numbber2 = Numbber2 * 10 + Remainder;


    }

    return Numbber2;

}




int DigitFrequency(int number, int Frequency) {

    int Remander = 0;
    int counter = 0;
    while (number > 0) {
        Remander = number % 10;
        if (Remander == Frequency) {

            counter++;

        }

        number = number / 10;


    }
    return counter;


}


void PrintAllDigitsFrequencey(int number)
{
    cout << endl;

    for (int i = 0; i < 10; i++)
    {
        short DigitFrequncy = DigitFrequency(number, i);

        if (DigitFrequncy != 0)
        {
            cout << "Digit " << i
                << " frequency is "
                << DigitFrequncy << endl;
        }
    }
}



