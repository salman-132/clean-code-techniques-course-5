#include <iostream>
#include<cstdlib>
#include<string>
using namespace std;


char RandomLetter (int From, int To) {

    int RandomNumber = rand() % (To - From + 1) + From;
    char letter=char (RandomNumber);
    return letter ;

}
string Readguess() {
    cout << "Enter your Guess :";
    string guess;
    cin >> guess;
    return guess;
}

string Password() {
    char Letter;
    string Pass ="";

    for (int i = 0; i <= 2; i++) {
    
        Letter = RandomLetter(65, 90);
        Pass = Pass + Letter;
    
    
    }

    return Pass;

}



int guessing(string Guess, string Pass)
{
    int counter = 0;

    for (int i = 0; i < 3; i++)
    {
        if (Guess[i] == Pass[i])
        {
            counter++;
        }
    }

    return counter;
}

 
void Challenge(string Pass)
{
    int counter = 0;

    while (counter != 3)
    {
        string Guess = Readguess();

        counter = guessing(Guess, Pass);

        switch (counter)
        {
        case 0:
            cout << "Correct Letter : 0/3" << endl;
            cout << "Wrong" << endl;
            break;

        case 1:
            cout << "Correct Letter : 1/3" << endl;
            cout << "Wrong" << endl;
            break;

        case 2:
            cout << "Correct Letter : 2/3" << endl;
            cout << "Wrong" << endl;
            break;

        case 3:
            cout << "Correct Password : 3/3" << endl;
            system("color 2E");
            break;
        }
    }
}







int main()
{
	srand((unsigned)time(NULL));
    
    string Pass = Password();

    Challenge(Pass);


}

 
