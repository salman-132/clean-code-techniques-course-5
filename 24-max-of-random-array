#include <iostream>
using namespace std;




int RandomNumber(int From, int To) {

    int RanNumber = rand() % (To - From - 1) + From;
    return RanNumber;

}


void ReadArrayNumber(int Array[100], int& lengh) {
    cout << "\n Enter number of elements:\n ";
    cin >> lengh;

    for (int i = 0; i < lengh; i++) {

        Array[i] = RandomNumber(1, 100);

    }

}



void PrintArray(int   Array[100], int lengh) {

    for (int i = 0; i < lengh; i++) {


        cout << Array[i] << " ";


    }
    cout << endl;




}


int FindMaxNumberInArray(int   Array[100], int lengh) {
    int maxNumber = 0;
    for (int i = 0; i < lengh;i++) {
    
        if (Array[i]>=maxNumber) {
        
            maxNumber = Array[i];
        
        }
    
    
    }

    return maxNumber;
}




int main()
{
     srand((unsigned)time(NULL));

     int Array[100], lengh;



     ReadArrayNumber(Array,lengh);
     PrintArray(Array, lengh);


     cout << "the large number in the array is:" << endl;
     cout << FindMaxNumberInArray(Array,lengh);






}

 
