int SumDigitFrequency(int number ,int Frequency) {

    int Remander = 0;
    int counter = 0;
    while (number >0) {
        Remander = number % 10;
        if (Remander == Frequency) {
        
            counter++;

        }

        number = number / 10;
 
    
    }
    return counter;


}






